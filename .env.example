# Copy this file to .env and fill in the keys you have. Leave the rest blank.
# The engine auto-detects which providers are available and probes their endpoints.
# Never commit .env (it is git-ignored).

ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
XAI_API_KEY=your-xai-key-here
ZAI_API_KEY=your-zai-key-here
MOONSHOT_API_KEY=your-moonshot-key-here

# Optional: a key for the web search tool that every model can call.
# Provider is chosen in config.json ("search.provider"), e.g. tavily or brave.
SEARCH_API_KEY=your-search-key-here

# Optional: extra keys for OpenAI-compatible endpoints not in the built-in list.
# Format: name=key; the engine probes the endpoints listed under
# "providers.extraCompatible" in config.json to find where the key works.
# MMT_EXTRA_KEY_MYPROVIDER=your-key-here
